rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
             data.email is string && data.email.size() <= 200 &&
             (!('avatarUrl' in data) || data.avatarUrl == null || (data.avatarUrl is string && data.avatarUrl.size() <= 500)) &&
             (!('preferredLanguage' in data) || data.preferredLanguage == null || (data.preferredLanguage is string && data.preferredLanguage.size() <= 50)) &&
             (!('preferredVoiceId' in data) || data.preferredVoiceId == null || (data.preferredVoiceId is string && data.preferredVoiceId.size() <= 50));
    }

    function isValidChatSession(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.characterId is string && data.characterId.size() <= 100 &&
             data.voiceId is string && data.voiceId.size() <= 100 &&
             data.lastMessage is string && data.lastMessage.size() <= 2000;
    }

    function isValidChatMessage(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.chatId is string && data.chatId.size() <= 128 &&
             data.sender in ['user', 'ai'] &&
             data.text is string && data.text.size() <= 50000 &&
             (!('characterId' in data) || data.characterId == null || (data.characterId is string && data.characterId.size() <= 100));
    }

    function isValidCreation(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.prompt is string && data.prompt.size() <= 4000 &&
             data.category is string && data.category.size() <= 100 &&
             (!('style' in data) || data.style == null || (data.style is string && data.style.size() <= 100)) &&
             data.imageData is string && data.imageData.size() <= 2000000 &&
             data.isTransparent is bool;
    }

    function isValidFavorite(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.promptId is string && data.promptId.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.category is string && data.category.size() <= 100 &&
             data.prompt is string && data.prompt.size() <= 5000;
    }

    function isValidWorldwidePrompt(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.prompt is string && data.prompt.size() <= 5000 &&
             data.category is string && data.category.size() <= 100 &&
             data.description is string && data.description.size() <= 1000 &&
             data.aiTool is string && data.aiTool.size() <= 100 &&
             data.trending is bool &&
             (!('tags' in data) || (data.tags is list && data.tags.size() <= 20));
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow get, list: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'displayName', 'email', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'email', 'avatarUrl', 'preferredLanguage', 'preferredVoiceId', 'createdAt', 'updatedAt']) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       isValidUserProfile(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'avatarUrl', 'preferredLanguage', 'preferredVoiceId', 'updatedAt']);

      allow delete: if isSignedIn() && request.auth.uid == userId;

      // Subcollection: Chats
      match /chats/{chatId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         request.auth.uid == userId &&
                         incoming().userId == request.auth.uid &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         isValidChatSession(incoming());

        allow update: if isSignedIn() &&
                         request.auth.uid == userId &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         isValidChatSession(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'characterId', 'voiceId', 'lastMessage', 'updatedAt']);

        allow delete: if isSignedIn() && request.auth.uid == userId;

        // Subcollection: Messages
        match /messages/{messageId} {
          allow get, list: if isSignedIn() && request.auth.uid == userId;

          allow create: if isSignedIn() &&
                           request.auth.uid == userId &&
                           incoming().userId == request.auth.uid &&
                           incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                           isValidChatMessage(incoming());

          allow update, delete: if isSignedIn() && request.auth.uid == userId;
        }
      }

      // Subcollection: Creations
      match /creations/{creationId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         request.auth.uid == userId &&
                         incoming().userId == request.auth.uid &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         isValidCreation(incoming());

        allow update: if isSignedIn() &&
                         request.auth.uid == userId &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         isValidCreation(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'prompt', 'category', 'style', 'imageData', 'isTransparent', 'updatedAt']);

        allow delete: if isSignedIn() && request.auth.uid == userId;
      }

      // Subcollection: Favorite Prompts
      match /favorite_prompts/{favoriteId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         request.auth.uid == userId &&
                         incoming().userId == request.auth.uid &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         isValidFavorite(incoming());

        allow delete: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // --- Worldwide Prompts Collection ---
    match /prompts/{promptId} {
      allow get, list: if isSignedIn();

      allow create, update, delete: if isSignedIn() &&
        (request.auth.token.email == '3863765sk@gmail.com' || (request.auth.token.keys().hasAll(['email_verified']) && request.auth.token.email_verified == true && request.auth.token.email == '3863765sk@gmail.com')) &&
        isValidWorldwidePrompt(incoming());
    }
  }
}
